			},
			ViewInfo = GroupInfo { Pos = { 440, 148.5 } },
			Tools = ordered() {
				RectMorphMaskInternal = RectangleMask {
			CtrlWZoom = false,
			NameSet = true,
			CustomData = {
				Path = {
					Map = {
						["Setting:"] = "Templates:/Fusion/Tools/"
					}
				},
			},
			Inputs = {
				Filter = Input { Value = FuID { "Fast Gaussian" }, },
				SoftEdge = Input { Value = 0, },
				BorderWidth = Input { Value = 0, },
				Invert = Input { Value = 0, },
				Width = Input {
					Value = 0.22,
					Expression = "(function() local pts = {}; local letters = {'A','B','C','D','E','F','G','H'}; local defF = {0,45,90,120,150,180,210,240}; local defW = {0.22,0.62,0.34,0.26,0.44,0.26,0.44,0.26}; local defH = {0.14,0.36,0.52,0.62,0.46,0.62,0.46,0.62}; local defC = {0.08,0.24,0.45,0.45,0.45,0.45,0.45,0.45}; local defM = {0,4,9,8,9,8,9,8}; local defD = {2,2,0,0,0,0,0,0}; local totalPts = math.max(2, math.min(8, math.floor((self.TotalPoints or 0) + 0.5) + 2)); for idx = 1, 8 do local L = letters[idx]; local en = (self['Pt'..L..'_Enable'] or 0) >= 0.5; local wVal = self['Pt'..L..'_Width'] or 0; local hVal = self['Pt'..L..'_Height'] or 0; local cVal = self['Pt'..L..'_Corner'] or 0; local fVal = self['Pt'..L..'_Frame'] or 0; local mVal = math.floor((self['Pt'..L..'_Anim'] or defM[idx]) + 0.5); local dVal = math.floor((self['Pt'..L..'_Dir'] or defD[idx]) + 0.5); local touched = (math.abs(wVal - defW[idx]) > 0.0005) or (math.abs(hVal - defH[idx]) > 0.0005) or (math.abs(cVal - defC[idx]) > 0.0005) or (math.abs(fVal - defF[idx]) > 0.1) or (mVal ~= defM[idx]) or (dVal ~= defD[idx]); if idx <= 2 or idx <= totalPts or en or touched then table.insert(pts, { f = fVal, v = self['Pt'..L..'_Width'] or 0, m = mVal, d = dVal, amp = self['Pt'..L..'_Intensity'] or 1.4, freq = self['Pt'..L..'_Freq'] or 2.5 }) end end; if #pts == 0 then return 0.25 end; table.sort(pts, function(a, b) return a.f < b.f end); if time <= pts[1].f then return pts[1].v end; if time >= pts[#pts].f then return pts[#pts].v end; local function fOut(u, m, amp, freq) if u <= 0 then return 0 elseif u >= 1 then return 1 end; if m == 0 then return u elseif m == 1 then return math.sin((u * math.pi) / 2) elseif m == 2 then return 1 - (1 - u)^2 elseif m == 3 then return 1 - (1 - u)^3 elseif m == 4 then return 1 - (1 - u)^4 elseif m == 5 then return 1 - (1 - u)^5 elseif m == 6 then return 1 - 2^(-10 * u) elseif m == 7 then return math.sqrt(math.max(0, 1 - (u - 1)^2)) elseif m == 8 then local c1 = 1.70158 * amp; local c3 = c1 + 1; return 1 + c3 * ((u - 1)^3) + c1 * ((u - 1)^2) elseif m == 9 then local p = 0.3 / math.max(0.5, freq * 0.4); return (2^(-10 * u)) * math.sin((u - p / 4) * (2 * math.pi) / p) * amp + 1 elseif m == 10 then local n1 = 7.5625; local d1 = 2.75; local x = u; if x < 1 / d1 then return n1 * x * x elseif x < 2 / d1 then x = x - 1.5 / d1; return n1 * x * x + 0.75 elseif x < 2.5 / d1 then x = x - 2.25 / d1; return n1 * x * x + 0.9375 else x = x - 2.625 / d1; return n1 * x * x + 0.984375 end end; return u end; local function ease(t, m, d, amp, freq) if m == 0 then return t end; if d == 0 then return fOut(t, m, amp, freq) elseif d == 1 then return 1 - fOut(1 - t, m, amp, freq) else if t < 0.5 then return 0.5 * (1 - fOut(1 - 2 * t, m, amp, freq)) else return 0.5 + 0.5 * fOut(2 * t - 1, m, amp, freq) end end end; for i = 1, #pts - 1 do local p1 = pts[i]; local p2 = pts[i+1]; if time >= p1.f and time <= p2.f then local dur = math.max(0.0001, p2.f - p1.f); local t = (time - p1.f) / dur; local e = ease(t, p2.m, p2.d, p2.amp, p2.freq); return p1.v + (p2.v - p1.v) * e end end; return pts[#pts].v end)()",
				},
				Height = Input {
					Value = 0.14,
					Expression = "(function() local pts = {}; local letters = {'A','B','C','D','E','F','G','H'}; local defF = {0,45,90,120,150,180,210,240}; local defW = {0.22,0.62,0.34,0.26,0.44,0.26,0.44,0.26}; local defH = {0.14,0.36,0.52,0.62,0.46,0.62,0.46,0.62}; local defC = {0.08,0.24,0.45,0.45,0.45,0.45,0.45,0.45}; local defM = {0,4,9,8,9,8,9,8}; local defD = {2,2,0,0,0,0,0,0}; local totalPts = math.max(2, math.min(8, math.floor((self.TotalPoints or 0) + 0.5) + 2)); for idx = 1, 8 do local L = letters[idx]; local en = (self['Pt'..L..'_Enable'] or 0) >= 0.5; local wVal = self['Pt'..L..'_Width'] or 0; local hVal = self['Pt'..L..'_Height'] or 0; local cVal = self['Pt'..L..'_Corner'] or 0; local fVal = self['Pt'..L..'_Frame'] or 0; local mVal = math.floor((self['Pt'..L..'_Anim'] or defM[idx]) + 0.5); local dVal = math.floor((self['Pt'..L..'_Dir'] or defD[idx]) + 0.5); local touched = (math.abs(wVal - defW[idx]) > 0.0005) or (math.abs(hVal - defH[idx]) > 0.0005) or (math.abs(cVal - defC[idx]) > 0.0005) or (math.abs(fVal - defF[idx]) > 0.1) or (mVal ~= defM[idx]) or (dVal ~= defD[idx]); if idx <= 2 or idx <= totalPts or en or touched then table.insert(pts, { f = fVal, v = self['Pt'..L..'_Height'] or 0, m = mVal, d = dVal, amp = self['Pt'..L..'_Intensity'] or 1.4, freq = self['Pt'..L..'_Freq'] or 2.5 }) end end; if #pts == 0 then return 0.25 end; table.sort(pts, function(a, b) return a.f < b.f end); if time <= pts[1].f then return pts[1].v end; if time >= pts[#pts].f then return pts[#pts].v end; local function fOut(u, m, amp, freq) if u <= 0 then return 0 elseif u >= 1 then return 1 end; if m == 0 then return u elseif m == 1 then return math.sin((u * math.pi) / 2) elseif m == 2 then return 1 - (1 - u)^2 elseif m == 3 then return 1 - (1 - u)^3 elseif m == 4 then return 1 - (1 - u)^4 elseif m == 5 then return 1 - (1 - u)^5 elseif m == 6 then return 1 - 2^(-10 * u) elseif m == 7 then return math.sqrt(math.max(0, 1 - (u - 1)^2)) elseif m == 8 then local c1 = 1.70158 * amp; local c3 = c1 + 1; return 1 + c3 * ((u - 1)^3) + c1 * ((u - 1)^2) elseif m == 9 then local p = 0.3 / math.max(0.5, freq * 0.4); return (2^(-10 * u)) * math.sin((u - p / 4) * (2 * math.pi) / p) * amp + 1 elseif m == 10 then local n1 = 7.5625; local d1 = 2.75; local x = u; if x < 1 / d1 then return n1 * x * x elseif x < 2 / d1 then x = x - 1.5 / d1; return n1 * x * x + 0.75 elseif x < 2.5 / d1 then x = x - 2.25 / d1; return n1 * x * x + 0.9375 else x = x - 2.625 / d1; return n1 * x * x + 0.984375 end end; return u end; local function ease(t, m, d, amp, freq) if m == 0 then return t end; if d == 0 then return fOut(t, m, amp, freq) elseif d == 1 then return 1 - fOut(1 - t, m, amp, freq) else if t < 0.5 then return 0.5 * (1 - fOut(1 - 2 * t, m, amp, freq)) else return 0.5 + 0.5 * fOut(2 * t - 1, m, amp, freq) end end end; for i = 1, #pts - 1 do local p1 = pts[i]; local p2 = pts[i+1]; if time >= p1.f and time <= p2.f then local dur = math.max(0.0001, p2.f - p1.f); local t = (time - p1.f) / dur; local e = ease(t, p2.m, p2.d, p2.amp, p2.freq); return p1.v + (p2.v - p1.v) * e end end; return pts[#pts].v end)()",
				},
				CornerRadius = Input {
					Value = 0.08,
					Expression = "(function() local pts = {}; local letters = {'A','B','C','D','E','F','G','H'}; local defF = {0,45,90,120,150,180,210,240}; local defW = {0.22,0.62,0.34,0.26,0.44,0.26,0.44,0.26}; local defH = {0.14,0.36,0.52,0.62,0.46,0.62,0.46,0.62}; local defC = {0.08,0.24,0.45,0.45,0.45,0.45,0.45,0.45}; local defM = {0,4,9,8,9,8,9,8}; local defD = {2,2,0,0,0,0,0,0}; local totalPts = math.max(2, math.min(8, math.floor((self.TotalPoints or 0) + 0.5) + 2)); for idx = 1, 8 do local L = letters[idx]; local en = (self['Pt'..L..'_Enable'] or 0) >= 0.5; local wVal = self['Pt'..L..'_Width'] or 0; local hVal = self['Pt'..L..'_Height'] or 0; local cVal = self['Pt'..L..'_Corner'] or 0; local fVal = self['Pt'..L..'_Frame'] or 0; local mVal = math.floor((self['Pt'..L..'_Anim'] or defM[idx]) + 0.5); local dVal = math.floor((self['Pt'..L..'_Dir'] or defD[idx]) + 0.5); local touched = (math.abs(wVal - defW[idx]) > 0.0005) or (math.abs(hVal - defH[idx]) > 0.0005) or (math.abs(cVal - defC[idx]) > 0.0005) or (math.abs(fVal - defF[idx]) > 0.1) or (mVal ~= defM[idx]) or (dVal ~= defD[idx]); if idx <= 2 or idx <= totalPts or en or touched then table.insert(pts, { f = fVal, v = self['Pt'..L..'_Corner'] or 0, m = mVal, d = dVal, amp = self['Pt'..L..'_Intensity'] or 1.4, freq = self['Pt'..L..'_Freq'] or 2.5 }) end end; if #pts == 0 then return 0.25 end; table.sort(pts, function(a, b) return a.f < b.f end); if time <= pts[1].f then return pts[1].v end; if time >= pts[#pts].f then return pts[#pts].v end; local function fOut(u, m, amp, freq) if u <= 0 then return 0 elseif u >= 1 then return 1 end; if m == 0 then return u elseif m == 1 then return math.sin((u * math.pi) / 2) elseif m == 2 then return 1 - (1 - u)^2 elseif m == 3 then return 1 - (1 - u)^3 elseif m == 4 then return 1 - (1 - u)^4 elseif m == 5 then return 1 - (1 - u)^5 elseif m == 6 then return 1 - 2^(-10 * u) elseif m == 7 then return math.sqrt(math.max(0, 1 - (u - 1)^2)) elseif m == 8 then local c1 = 1.70158 * amp; local c3 = c1 + 1; return 1 + c3 * ((u - 1)^3) + c1 * ((u - 1)^2) elseif m == 9 then local p = 0.3 / math.max(0.5, freq * 0.4); return (2^(-10 * u)) * math.sin((u - p / 4) * (2 * math.pi) / p) * amp + 1 elseif m == 10 then local n1 = 7.5625; local d1 = 2.75; local x = u; if x < 1 / d1 then return n1 * x * x elseif x < 2 / d1 then x = x - 1.5 / d1; return n1 * x * x + 0.75 elseif x < 2.5 / d1 then x = x - 2.25 / d1; return n1 * x * x + 0.9375 else x = x - 2.625 / d1; return n1 * x * x + 0.984375 end end; return u end; local function ease(t, m, d, amp, freq) if m == 0 then return t end; if d == 0 then return fOut(t, m, amp, freq) elseif d == 1 then return 1 - fOut(1 - t, m, amp, freq) else if t < 0.5 then return 0.5 * (1 - fOut(1 - 2 * t, m, amp, freq)) else return 0.5 + 0.5 * fOut(2 * t - 1, m, amp, freq) end end end; for i = 1, #pts - 1 do local p1 = pts[i]; local p2 = pts[i+1]; if time >= p1.f and time <= p2.f then local dur = math.max(0.0001, p2.f - p1.f); local t = (time - p1.f) / dur; local e = ease(t, p2.m, p2.d, p2.amp, p2.freq); return p1.v + (p2.v - p1.v) * e end end; return pts[#pts].v end)()",
				},
