					LINKID_DataType = "Number",
					INPID_InputControl = "ButtonControl",
					BTNCS_Execute = "local letters = {\"A\",\"B\",\"C\",\"D\",\"E\",\"F\",\"G\",\"H\"}\nlocal t = comp.CurrentTime or 0\nlocal function getNum(name, def)\n  local tgt = tool.RectMorphMaskInternal or tool\n  local ok1, v1 = pcall(function() return tonumber(tgt:GetInput(name, t)) or tonumber(tool:GetInput(name, t)) end)\n  if ok1 and v1 ~= nil then return v1 end\n  local ok2, v2 = pcall(function() return tonumber(tool[name][t]) end)\n  if ok2 and v2 ~= nil then return v2 end\n  return def\nend\nlocal function setNum(name, val)\n  local tgt = tool.RectMorphMaskInternal or tool\n  pcall(function() tgt:SetInput(name, val, t) end)\n  pcall(function() tgt[name][t] = val end)\n  pcall(function() tool:SetInput(name, val, t) end)\n  pcall(function() tool[name][t] = val end)\nend\n\nlocal curIdx = getNum(\"TotalPoints\", 1)\nlocal count = math.max(2, math.min(8, math.floor(curIdx + 0.5) + 2))\n\nfor i = 3, 8 do\n  local g = letters[i]\n  if getNum(\"Pt\"..g..\"_Enable\", 0) >= 0.5 and i > count then\n    count = i\n  end\nend\n\nif count <= 2 then\n  setNum(\"TotalPoints\", 0)\n  for i = 3, 8 do\n    local g = letters[i]\n    setNum(\"Pt\"..g..\"_Enable\", 0)\n    setNum(\"Pt\"..g..\"_Group\", 0)\n  end\n  return\nend\n\nlocal L = letters[count]\nlocal nextCount = count - 1\n\nsetNum(\"TotalPoints\", nextCount - 2)\nsetNum(\"Pt\"..L..\"_Enable\", 0)\nsetNum(\"Pt\"..L..\"_Group\", 0)",
