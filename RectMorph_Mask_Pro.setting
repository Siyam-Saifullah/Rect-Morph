return 1 - fOut(1 - t, m, amp, freq) else if t < 0.5 then return 0.5 * (1 - fOut(1 - 2 * t, m, amp, freq)) else return 0.5 + 0.5 * fOut(2 * t - 1, m, amp, freq) end end end; for i = 1, #pts - 1 do local p1 = pts[i]; local p2 = pts[i+1]; if time >= p1.f and time <= p2.f then local dur = math.max(0.0001, p2.f - p1.f); local t = (time - p1.f) / dur; local e = ease(t, p2.m, p2.d, p2.amp, p2.freq); return p1.v + (p2.v - p1.v) * e end end; return pts[#pts].v end)()",
